# Supabase project (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used ONLY in server-side admin storage operations
# (e.g. deleting orphaned files). Never exposed to the client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for metadata/OG tags and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
